# --- database ---
SQC_DATABASE_URL=postgresql+psycopg://sqc_app:changeme@localhost:5432/sqc
SQC_ADMIN_DATABASE_URL=postgresql+psycopg://sqc:sqc@localhost:5432/sqc

# --- embeddings (must match SQC_EMBEDDING_DIM used at migration time) ---
SQC_EMBEDDING_PROVIDER=voyage        # voyage | openai | local | fake
SQC_EMBEDDING_MODEL=voyage-3
SQC_EMBEDDING_DIM=1024
VOYAGE_API_KEY=

# --- reranking ---
SQC_RERANK_PROVIDER=voyage           # voyage | cohere | none | fake
SQC_RERANK_MODEL=rerank-2

# --- answering llm ---
SQC_LLM_PROVIDER=anthropic           # anthropic | openai | fake
# claude-sonnet-5 is the cost/quality default. claude-opus-5 for hard
# questions, claude-haiku-4-5-20251001 for cheap bulk runs.
SQC_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=

# --- retrieval / refusal thresholds (tuned via evals, never guessed) ---
SQC_CANDIDATES_PER_RETRIEVER=40
SQC_EVIDENCE_TOP_K=6
SQC_RRF_K=60
SQC_RETRIEVAL_FLOOR=0.30
SQC_CONFIDENCE_HIGH=0.75
SQC_CONFIDENCE_MEDIUM=0.50

# --- database ---
SQC_DATABASE_URL=postgresql+psycopg://sqc_app:changeme@localhost:5432/sqc
SQC_ADMIN_DATABASE_URL=postgresql+psycopg://sqc:sqc@localhost:5432/sqc

# --- embeddings (must match SQC_EMBEDDING_DIM used at migration time) ---
SQC_EMBEDDING_PROVIDER=voyage        # voyage | openai | local | fake
SQC_EMBEDDING_MODEL=voyage-3
SQC_EMBEDDING_DIM=1024
VOYAGE_API_KEY=

# --- reranking ---
# voyage | none | fake. Defaults to none: the fake reranker ranks worse
# than plain fusion, so it belongs in tests only.
SQC_RERANK_PROVIDER=none
SQC_RERANK_MODEL=rerank-2

# --- claim support checking ---
# lexical | llm | none. Lexical is deterministic, free, and catches a claim
# naming a figure or standard the evidence never mentions. It cannot judge
# paraphrase; llm can, at the cost of a second model call per claim.
SQC_ENTAILMENT_PROVIDER=lexical

# --- answering llm ---
# anthropic | gemini | manual | fake
#   gemini  - free tier at aistudio.google.com, Flash models only.
#             Google may train on free-tier data: fine for testing
#             against a public policy, not for customer documents.
#   manual  - prints the prompt for you to paste into any chat window
#             and reads the JSON back. No account, no cost.
SQC_LLM_PROVIDER=anthropic
# claude-sonnet-5 is the cost/quality default. claude-opus-5 for hard
# questions, claude-haiku-4-5-20251001 for cheap bulk runs.
SQC_LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# AI Studio now issues authorization keys, which start with AQ. rather
# than AIza. Both go in the same header; standard AIza keys stop working
# entirely in September 2026.
GEMINI_API_KEY=

# --- retrieval / refusal thresholds (tuned via evals, never guessed) ---
SQC_CANDIDATES_PER_RETRIEVER=40
SQC_EVIDENCE_TOP_K=6
# Must stay small relative to SQC_CANDIDATES_PER_RETRIEVER. At k=60 with 40
# candidates, any chunk found by both retrievers outranks every chunk found by
# only one, whatever the ranks - fusion stops using rank at all.
SQC_RRF_K=10
# gate 1: below this, refuse without calling the LLM. 0.0 = disabled.
# Rerank scores differ by provider, so calibrate against the eval set
# before enabling; an uncalibrated floor refuses answerable questions.
SQC_RETRIEVAL_FLOOR=0.0
SQC_CONFIDENCE_HIGH=0.75
SQC_CONFIDENCE_MEDIUM=0.50
